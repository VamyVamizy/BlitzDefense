<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="admin-container">
        <h1>Admin Panel</h1>
        <p>Welcome, <%= user %>!</p>

        <div class="price-management">
            <h2>Game Price Management</h2>
            <p>Current Price: <strong>
                    <%= currentPrice %> Digipogs
                </strong></p>

            <!-- Your task: Add a form here to update the price -->

            <form action="/admin/updatePrice" method="POST">
                <label for="newPrice">New Price (Digipogs): </label>
                <input type="number" id="newPrice" name="newPrice" min="0" required />
                <button type="submit">Update Price</button>
                <button type="button" onclick="window.location.href='/playerbase'">Player Base</button>
                <button type="button" onclick="window.location.href='/'">To Game</button>
            </form>

            <div class="admin-digipog-tools">
                <h2>Admin Game Tools</h2>
                <button id="setDigipogsBtn" type="button">Set My Digipogs High</button>
                <span id="setDigipogsStatus" role="status"></span>
            </div>


        </div>
    </div>
    <script>
        document.getElementById('setDigipogsBtn').addEventListener('click', async () => {
            const button = document.getElementById('setDigipogsBtn');
            const status = document.getElementById('setDigipogsStatus');
            button.disabled = true;
            try {
                const response = await fetch('/admin/setDigipogs', { method: 'POST' });
                const data = await response.json();
                if (!response.ok || !data.ok) throw new Error(data.error || 'Unable to set Digipogs');
                window.location.href = '/';
            } catch (error) {
                status.textContent = error.message;
                button.disabled = false;
            }
        });
    </script>
</body>

</html>